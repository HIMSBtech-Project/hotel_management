PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hotelreserve
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Public payment recipient details shown only to signed-in customers.
PAYMENT_MTN_RECIPIENT=MTN MoMo: 237XXXXXXXXX
PAYMENT_ORANGE_RECIPIENT=Orange Money: 237XXXXXXXXX

# Required only when running npm run create-admin.
ADMIN_NAME=Hotel Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
